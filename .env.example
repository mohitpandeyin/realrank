# Runtime
APP_ENV=development
APP_URL=http://localhost:3000

# PostgreSQL (server only)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/realrank
DATABASE_SSL=false

# Razorpay Test Mode (server only)
# Create a separate webhook secret in Razorpay; do not reuse the API secret.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Never prefix provider secrets with NEXT_PUBLIC_.
